# Copy to .env for local development.
DATABASE_URL=postgres://mysignalchain:mysignalchain@127.0.0.1:5433/mysignalchain
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Optional locally. Without these, Google sign-in is turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enables the test-only sign-in route. Never set this in production.
E2E_TEST_LOGIN_ENABLED=false
